{
  "info": {
    "name": "Energy Management - Auth Microservice",
    "description": "Colecție Postman pentru testarea microserviciului de autentificare",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('adminToken', jsonData.token);",
              "    console.log('Admin token salvat: ' + jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"admin@energy.ro\",\n    \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login cu contul de ADMIN creat manual în baza de date"
      },
      "response": []
    },
    {
      "name": "2. Validate Token ADMIN",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/validate?token={{adminToken}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "validate"],
          "query": [
            {
              "key": "token",
              "value": "{{adminToken}}"
            }
          ]
        },
        "description": "Validează token-ul JWT al adminului"
      },
      "response": []
    },
    {
      "name": "3. Register CLIENT (cu token ADMIN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('clientToken', jsonData.token);",
              "    console.log('Client token salvat: ' + jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"client1\",\n    \"email\": \"client1@energy.ro\",\n    \"password\": \"client123\",\n    \"role\": \"CLIENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Creează un nou CLIENT folosind token-ul de ADMIN"
      },
      "response": []
    },
    {
      "name": "4. Login CLIENT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"client1@energy.ro\",\n    \"password\": \"client123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login cu contul de CLIENT creat anterior"
      },
      "response": []
    },
    {
      "name": "5. Register ADMIN (cu token ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"admin2\",\n    \"email\": \"admin2@energy.ro\",\n    \"password\": \"admin456\",\n    \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Creează un nou ADMIN folosind token-ul de ADMIN"
      },
      "response": []
    },
    {
      "name": "6. Register fără token (EROARE 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"hacker\",\n    \"email\": \"hacker@evil.com\",\n    \"password\": \"hack123\",\n    \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Încearcă să creeze user fără token - trebuie să dea 403 Forbidden"
      },
      "response": []
    },
    {
      "name": "7. Register cu token CLIENT (EROARE 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{clientToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"client2\",\n    \"email\": \"client2@energy.ro\",\n    \"password\": \"client123\",\n    \"role\": \"CLIENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Încearcă să creeze user cu token de CLIENT - trebuie să dea 403 Forbidden"
      },
      "response": []
    },
    {
      "name": "8. Validate Token CLIENT",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/validate?token={{clientToken}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "validate"],
          "query": [
            {
              "key": "token",
              "value": "{{clientToken}}"
            }
          ]
        },
        "description": "Validează token-ul JWT al clientului"
      },
      "response": []
    }
  ]
}
